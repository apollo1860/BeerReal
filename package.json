{
  "name": "beerreal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "dev:emulator": "VITE_FIREBASE_EMULATOR=1 vite",
    "emulators": "npx -y firebase-tools@15 emulators:start --only auth,database --project demo-beerreal",
    "deploy": "npm run build && npx -y firebase-tools@15 deploy --only hosting,database"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
