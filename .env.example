# Kopieren nach .env.local und mit den Werten aus der Firebase-Konsole füllen
# (Projekteinstellungen → Allgemein → Deine Apps → Web-App → SDK-Konfiguration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Zum lokalen Testen mit den Firebase-Emulatoren statt echtem Projekt:
# VITE_FIREBASE_EMULATOR=1
